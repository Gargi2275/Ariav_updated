# MySQL — names MUST match config/settings.py (do not rename).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ariav_erp
DB_USER=ariav
DB_PASSWORD=change-me

# Required when DJANGO_DEBUG=false (the app refuses to start without it).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# Only behind a reverse proxy that overwrites X-Forwarded-For:
# DJANGO_TRUST_X_FORWARDED_FOR=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Extra CORS origins if needed (LAN IPs are allowed automatically when DJANGO_DEBUG=true)
# DJANGO_CORS_ALLOWED_ORIGINS=http://192.168.1.20:5173

# LOCAL DEV ONLY — never use these values in production
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=admin123
# Admin PIN is never configured here. Set it with: python manage.py reset_admin_pin <username>
DEV_OPERATOR_USERNAME=bhavin.operator
DEV_OPERATOR_PASSWORD=operator123

# Days ahead for Upcoming Due invoice reminders (generate_reminders)
# NOTIFICATION_UPCOMING_DUE_DAYS=3
